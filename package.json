{
  "name": "slides-mcp",
  "version": "1.0.0",
  "description": "MCP server that converts structured JSON slideshows to PowerPoint presentations via LibreOffice",
  "type": "module",
  "main": "dist/server/stdioServer.js",
  "bin": {
    "slides-mcp": "dist/server/stdioServer.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start:http": "node dist/server/httpServer.js",
    "start:stdio": "node dist/server/stdioServer.js",
    "test": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules --no-warnings' jest --watch",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "slides",
    "powerpoint",
    "pptx",
    "odp",
    "libreoffice"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^4.21.2",
    "zod": "^3.24.1",
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
